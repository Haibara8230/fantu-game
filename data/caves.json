        "hidden": {"name": "药园深处的寿藤", "sense": 60, "qi": 30, "loot": [[{"item": ["shouyuan_guo", 1]}], [{"manual": 4}]]}
      },
      {
        "id": "pool", "name": "霞光灵池", "links": ["garden"], "map": [0.74, 0.14],
