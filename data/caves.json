        "hidden": {"name": "池底的灵石髓", "sense": 72, "qi": 40, "loot": [[{"stones": 600}], [{"item": ["ningyuan_dan", 2]}], [{"item": ["jade_han", 3]}, {"item": ["silk_yunjin", 3]}]]}
      },
      {
        "id": "tomb", "name": "剑冢", "links": ["stairs", "library"], "map": [0.5, 0.78],
