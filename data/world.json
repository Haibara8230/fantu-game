  "locations": {
    "sect": {
      "name": "青云山",
      "subtitle": "山中无甲子，修行亦有时。",
      "description": "青云剑宗外门所在。云雾绕着峰腰，钟声每日三响。",
      "terrain": "mountain",
      "map": [0.24, 0.24],
      "spots": [{"id": "gate", "tag": [0.5, 0.78], "name": "山门", "description": "魔潮压在山门之外，护山大阵的光幕时明时暗。魔将就在阵外叫阵。", "actions": ["battle:mo_jiang"], "requires_flag": "calamity"}, 
        {"id": "chamber", "tag": [0.32, 0.29], "name": "静室", "description": "外门弟子的静修之所，灵气清润，可闭关、休整与突破；角落里有一口公用丹炉，也可开炉炼丹。", "actions": ["cultivate", "rest", "breakthrough", "alchemy"]},
        {"id": "office", "tag": [0.53, 0.35], "name": "执事堂", "description": "执事们在这里张贴宗门的委托，按时完成可得酬劳与贡献；月俸、晋升、兑换与捐献也在这里办理。", "actions": ["commissions", "sect"], "requires_flag": "intro_done"},
        {"id": "abode", "tag": [0.3, 0.12], "name": "洞府", "description": "内门弟子各有一处洞府，石门后是静修的石室，门外辟出一方灵田，引了山泉浇灌。", "actions": ["field"], "requires_rank": "inner"},
        {"id": "arena", "tag": [0.42, 0.5], "name": "演武坪", "description": "青石铺就的演武坪，同门常在此切磋。十年一度的外门小比也在这里报名、比斗。", "actions": ["battle:disciple", "tournament"]},
        {"id": "hall", "tag": [0.25, 0.42], "name": "传功堂", "description": "堂中供着本门青云剑诀的传承玉简，弟子可在此研习；执事也传授几门入门功法，参悟需要时日。他派神通不在此传授。", "actions": ["study", "teach"], "requires_flag": "intro_done", "teach": ["t:breath:wood:1::0", "t:body:earth:1::5", "t:focus:water:1::10", "t:bolt:metal:1::15"]}
      ]
    },
    "town": {
      "name": "青石镇",
      "subtitle": "山门脚下，凡俗烟火。",
      "description": "青云山脚下的凡人小镇。往来修士常在此歇脚，也在茶馆里打听消息。",
      "terrain": "town",
      "map": [0.4, 0.42],
      "spots": [
        {"id": "inn", "tag": [0.11, 0.4], "name": "青石客栈", "description": "掌柜识得修士，备有净室与药膳。花几块灵石便能好好歇上一日。", "actions": ["inn_rest"]},
        {"id": "teahouse", "tag": [0.35, 0.44], "name": "听雨茶馆", "description": "说书先生醒木一拍，南来北往的消息都汇在这里。", "actions": ["inquire"]}
      ]
    },
    "ferry": {
      "name": "白鹭渡",
      "subtitle": "一水横陈，舟渡东西。",
      "description": "云溪上游的渡口，渡船往返于青石镇与坊市之间，白鹭常在浅滩起落。",
      "terrain": "ferry",
      "map": [0.6, 0.5],
      "spots": [{"id": "crossing", "tag": [0.7, 0.3], "name": "天河渡口", "description": "白鹭渡上空裂开一道银白的天河，河上浮着一座看不见对岸的渡桥。传说化神圆满的修士踏上桥去，便再不回来。", "actions": ["ascend"], "requires_flag": "ascension_open"}, 
        {"id": "dock", "tag": [0.33, 0.47], "name": "渡口", "description": "老艄公撑着竹篙，等客满便开船。等船的人最爱闲聊。", "actions": ["inquire", "battle:jiao"]}
      ]
    },
