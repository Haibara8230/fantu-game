        {"id": "slope", "tag": [0.54, 0.56], "name": "灵草坡", "description": "向阳的缓坡上灵草丛生。", "actions": ["gather"]},
        {"id": "spring", "tag": [0.37, 0.36], "name": "深谷灵泉", "description": "谷底的灵泉被赤鳞妖蟒盘踞。", "actions": ["battle:serpent"]},
        {"id": "eye", "tag": [0.12, 0.36], "name": "灵眼", "description": "山壁裂隙后藏着一眼灵泉，天地灵气在此汇聚成漩。在这里闭关突破，把握更大。", "actions": ["breakthrough"], "requires_flag": "spirit_eye_found"}
      ]
    },
