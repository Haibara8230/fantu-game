      "map": [0.4, 0.42],
      "spots": [
        {"id": "inn", "name": "青石客栈", "description": "掌柜识得修士，备有净室与药膳。花几块灵石便能好好歇上一日。", "actions": ["inn_rest"]},
        {"id": "teahouse", "name": "听雨茶馆", "description": "说书先生醒木一拍，南来北往的消息都汇在这里。", "actions": []}
      ]
    },
