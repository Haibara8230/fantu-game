        {"id": "slope", "tag": [0.54, 0.56], "name": "灵草坡", "description": "向阳的缓坡上灵草丛生。", "actions": ["gather"]},
        {"id": "spring", "tag": [0.37, 0.36], "name": "深谷灵泉", "description": "谷底的灵泉被赤鳞妖蟒盘踞。", "actions": ["battle:serpent", "battle:mo_xiu"]}, {"id": "chenxia", "tag": [0.55, 0.3], "name": "沉霞古境", "description": "晚霞沉进谷底的雾里，雾中现出一道石门。古境一甲子开一回，开一年便合上。", "actions": ["explore_cave"], "requires_flag": "chenxia_open"},
        {"id": "eye", "tag": [0.12, 0.36], "name": "灵眼", "description": "山壁裂隙后藏着一眼灵泉，天地灵气在此汇聚成漩。在这里闭关突破，把握更大。", "actions": ["breakthrough"], "requires_flag": "spirit_eye_found"}
