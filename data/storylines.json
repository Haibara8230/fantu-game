  "talent_hundun": {"title": "混沌之体", "giver": "gu_changgeng", "begin_if": [{"talent": "hundun"}], "steps": [{"id": "notice", "goal": "去青云山传功堂，见一见传功长老顾长庚。", "place": "sect", "requires": [{"flag": "rushi_done"}], "done": [{"talked": "gu_changgeng"}, {"at_location": "sect"}], "after": "顾长庚一把扣住你的脉门，脸色变了又变：“五行俱全，混沌未分……混沌灵体！老夫活了一百多年，只在典籍里见过。”他取出一枚珍藏的玉简，“你的路，宗门的功法怕是不够用。”", "effects": [{"manual": 3}, {"mind": 5}, {"relation": ["gu_changgeng", 20]}], "major": true}, {"id": "trial", "goal": "筑基之后，回传功堂见顾长庚。", "place": "sect", "requires": [{"realm_at_least": 1}], "done": [{"at_location": "sect"}], "after": "顾长庚领你到后山一处灵脉，亲自为你护持了三日：“混沌灵体筑基之后，便该引五行之气淬体了。”", "effects": [{"xp": 2500}, {"mind": 5}]}]},
  "talent_jianti": {"title": "万剑朝宗", "giver": "boatman", "begin_if": [{"talent": "xiantian_jianti"}], "steps": [{"id": "river", "goal": "去白鹭渡，看一看河底的剑痕。", "place": "ferry", "requires": [{"stage_at_least": [0, 1]}], "done": [{"at_location": "ferry"}], "after": "你刚走到渡口，河底万千剑痕同时嗡鸣，江面上浮起一层细碎的剑光。老艄公看得呆了：“几十年了，它们头一回这样。”", "effects": [{"manual": 3}, {"mind": 5}, {"relation": ["boatman", 15]}], "major": true}, {"id": "cave", "goal": "筑基之后，去古修洞府看看那里的剑意。", "place": "ruin", "requires": [{"realm_at_least": 1}, {"flag": "ruin_cleared"}], "done": [{"at_location": "ruin"}], "after": "洞府石壁上的剑痕随你的呼吸明灭，最后汇成一道剑光没入你的眉心——是前人留在这里的一门剑诀。", "effects": [{"manual": 4}], "major": true}]},
  "talent_wangqing": {"title": "太上忘情", "giver": "shen_mo", "begin_if": [{"talent": "wangqing"}], "steps": [{"id": "pulse", "goal": "去云溪药铺，让沈墨看一看。", "place": "market", "requires": [{"flag": "rushi_done"}], "done": [{"at_location": "market"}], "after": "沈墨替你把了脉，收回手时神色古怪：“心如古井，七情不动……太上忘情。这样的人修行快，可也容易走着走着，就忘了自己为什么修行。”", "effects": [{"mind": 10}]}, {"id": "after", "goal": "筑基之后，再去云溪药铺见沈墨。", "place": "market", "requires": [{"realm_at_least": 1}], "done": [{"at_location": "market"}], "after": "沈墨递给你一壶酒：“筑基了？喝一口。忘情不是无情，你记着这句话就够了。”", "effects": [{"mind": 15}, {"xp": 1500}, {"relation": ["shen_mo", 15]}], "major": true}]},
  "talent_wangu": {"title": "万古长青", "giver": "azhi", "begin_if": [{"talent": "wangu"}], "steps": [{"id": "pines", "goal": "去松风岭走一走。", "place": "ridge", "requires": [{"flag": "rushi_done"}], "done": [{"at_location": "ridge"}], "after": "你一踏进松林，满山老松的枝叶都朝你这边倾了倾。阿芷瞪大了眼睛：“它们……在跟你打招呼？”她领你到一处只有她知道的崖下，那里长着两株灵芝。", "effects": [{"item": ["lingzhi", 2]}, {"relation": ["azhi", 15]}]}, {"id": "grove", "goal": "筑基之后，再去松风岭。", "place": "ridge", "requires": [{"realm_at_least": 1}], "done": [{"at_location": "ridge"}], "after": "松风岭深处的老树林为你让开了一条路，路的尽头是一片长满灵草的空地，像是等了你很久。", "effects": [{"item": ["lingzhi", 3]}, {"mind": 5}], "major": true}]},
  "talent_daogu": {"title": "道骨天成", "giver": "gu_changgeng", "begin_if": [{"talent": "daogu"}], "steps": [{"id": "bones", "goal": "修到炼气圆满，去传功堂见顾长庚。", "place": "sect", "requires": [{"stage_at_least": [0, 3]}], "done": [{"at_location": "sect"}], "after": "顾长庚摸过你的骨相，长叹一声：“道骨天成。旁人筑基是闯关，你是推门。”他取出一枚筑基丹，“老夫当年留着没舍得用，给你吧。”", "effects": [{"item": ["foundation_pill", 1]}, {"relation": ["gu_changgeng", 15]}], "major": true}, {"id": "after", "goal": "筑基之后，回传功堂。", "place": "sect", "requires": [{"realm_at_least": 1}], "done": [{"at_location": "sect"}], "after": "顾长庚看着你，笑得像个孩子：“老夫没看走眼。”他把压箱底的一枚玉简交到你手里。", "effects": [{"manual": 3}, {"mind": 5}]}]},
  "talent_ziqi": {"title": "紫气东来", "giver": "peddler", "begin_if": [{"talent": "ziqi"}], "steps": [{"id": "luck", "goal": "去云溪坊市逛一逛。", "place": "market", "requires": [{"flag": "rushi_done"}], "done": [{"at_location": "market"}], "after": "你在坊市里随手买的一块旧砚台，掌柜刚找完零钱，砚台就裂开了——里面藏着一叠灵石票。路过的行脚药贩钱货郎看得直咂嘴：“紫气东来，紫气东来啊！”", "effects": [{"stones": 300}, {"meet": "peddler"}]}, {"id": "fortune", "goal": "筑基之后，再去云溪坊市。", "place": "market", "requires": [{"realm_at_least": 1}], "done": [{"at_location": "market"}], "after": "坊市里的掌柜们像是约好了一样，纷纷把压箱底的好东西拿出来，只收你本钱价。你满载而归。", "effects": [{"stones": 500}, {"item": ["ningqi_pill", 2]}], "major": true}]},
  "talent_tiandu": {"title": "天妒", "giver": "shen_mo", "begin_if": [{"talent": "tiandu"}], "steps": [{"id": "pulse", "goal": "去云溪药铺，请沈墨把一把脉。", "place": "market", "requires": [{"flag": "rushi_done"}], "done": [{"at_location": "market"}], "after": "沈墨把完脉，半天没说话，最后只道：“天资太好的人，老天爷是要收回去的。你修行要快——比谁都快。”他塞给你两枚凝气丹。", "effects": [{"item": ["ningqi_pill", 2]}, {"mind": 5}], "major": true}, {"id": "remedy", "requires": [{"stage_at_least": [0, 3]}], "say": "沈墨托人捎来一只药匣，里面是他多年搜集的续命方子，还有一句话：“筑基能续寿。快些。”", "effects": [{"item": ["liaoshang_pill", 2]}, {"mind": 5}], "auto": true}]},
  "talent_sushi": {"title": "宿世灵童", "giver": "xu_qinghe", "begin_if": [{"talent": "sushi"}], "steps": [{"id": "library", "goal": "回青云山，去执事堂见许清和。", "place": "sect", "requires": [{"flag": "rushi_done"}], "done": [{"talked": "xu_qinghe"}, {"at_location": "sect"}], "after": "许清和满脸狐疑：“藏经阁第三排架子底下有个暗格，连我都是上个月才知道的——你怎么会知道？”暗格里是一枚落满灰的玉简。", "effects": [{"manual": 2}, {"mind": 5}, {"relation": ["xu_qinghe", 10]}]}, {"id": "memory", "goal": "筑基之后，再去执事堂。", "place": "sect", "requires": [{"realm_at_least": 1}], "done": [{"at_location": "sect"}], "after": "又一段前世的记忆醒来：宗门后山的一块青石下，埋着你前世留下的东西。许清和陪你挖了半日，挖出一只玉匣。", "effects": [{"manual": 3}, {"mind": 5}], "major": true}]},
