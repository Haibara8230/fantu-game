  "south_wander": {"title": "南行", "giver": "shen_mo", "begin_if": [{"realm_at_least": 1}, {"flag": "rushi_done"}, {"affiliation": ""}], "steps": [{"id": "wait", "wait_days": 60}, {"id": "letter", "letter": true, "skip_if": [{"flag": "tiannan_known"}], "say": "“筑基了？云溪困不住你了。来药铺一趟，同你说说天南。”", "goal": "回云溪药铺，听沈墨说说天南。", "place": "market", "done": [{"at_location": "market"}], "after": "沈墨摊开一张旧舆图：“天南五城，云溪最小。坊市东头的传送阵通南明，四十灵石一趟；南明再往北是北岳，古物多，骗子也多。散修在天南，靠的是客栈的静房、告示板上的委托，还有各城的门路。”", "effects": [{"flag": "tiannan_known"}, {"mind": 3}]}, {"id": "visit", "goal": "经云溪的传送阵，去南明城看看。", "place": "nanming", "done": [{"at_location": "nanming"}], "after": "热风扑面。南明城的长街被千百座炉火映得通红；城西的火塘客栈挂着「静房按月」的木牌，告示板上的委托比云溪多出两倍。", "effects": [{"mind": 3}], "major": true}]},
  "liu_case": {"title": "断剑旧案", "giver": "wounded", "steps": [{"id": "tale", "goal": "柳寒舟在北岳城落脚：去北岳客栈找他，听他把话说完。", "place": "beiyue", "requires": [{"realm_at_least": 1}, {"flag": "tiannan_known"}], "done": [{"at_location": "beiyue"}], "after": "柳寒舟把断剑横在桌上：“我师门叫断剑门，三十年前一夜之间死在断剑峡里。玄岳宗的卷宗上写：私通魔修，自取其祸。我不信。”他没求你帮忙，只说他会在北岳等，等一个当年的人。", "effects": [{"relation": ["wounded", 10]}]}, {"id": "witness", "letter": true, "requires": [{"year_at_least": 40}], "say": "“他来了。”——只有三个字。", "goal": "柳寒舟等的人到了北岳：去听那位证人怎么说。", "place": "beiyue", "done": [{"at_location": "beiyue"}], "after": "证人是个老脚夫，叫卢七，当年给断剑门送粮。他说出事那夜，进峡的不是魔修，是玄岳宗的执法弟子——断剑门挖开了峡底的剑冢，玄岳说那底下镇着不该动的东西。第二天玄岳的人进峡收尸，卷宗上却一个字都没提剑冢。", "effects": [{"mind": 3}]}, {"id": "evidence", "goal": "两相对照：拿到进北岳旧档库的门路调出断剑门的卷宗，再去断剑峡的断剑林找当年的实物。", "place": "duanjian", "done": [{"flag": "archive_pass"}, {"flag": "duanjian_ling_down"}], "after": "卷宗上「私通魔修」四个字是后来补的，墨色比前后都新；断剑林里，你在剑灵首散落的碎剑间翻出一块玄岳执法令牌，背面刻着三十年前的年号。证人、卷宗、令牌，三样对得上。"}, {"id": "decide", "goal": "把证据交到柳寒舟手里，一起定下怎么了结。", "place": "beiyue", "choice_event": "liu_choice"}]},
  "lu_heir": {"title": "陆家", "giver": "lu_chengzhou", "steps": [{"id": "funeral", "letter": true, "say": "（声音哑得厉害）“我哥没了。你……能来一趟吗？”", "goal": "去云溪陆府吊唁陆承岳。", "place": "market", "done": [{"at_location": "market"}], "after": "灵堂里，陆承舟穿着孝服，跪得笔直。散了客，他坐在台阶上说：“家里的生意，以后归我管了。我连账本都看不懂。”他笑了一下，比哭还难看。", "effects": [{"flag": "lu_head"}, {"relation": ["lu_chengzhou", 10]}]}, {"id": "wait", "wait_days": 1800}, {"id": "ledger", "letter": true, "say": "“有笔账我看不明白——每月都有一批延寿药胚，从南明发往赤枫岭的旧矿道。矿道早不出矿了。你帮我去南明万宝楼对一对？”", "goal": "去南明城，替陆承舟对一笔发往赤枫岭旧矿道的账。", "place": "nanming", "done": [{"at_location": "nanming"}], "after": "万宝楼的掌柜翻出底单：药胚是陆家二房的人经手的，收货的是旧矿道的护院。一批药胚，够几十个人吃一年。矿道里要这么多延寿药做什么？", "effects": [{"flag": "lu_mine_known"}]}, {"id": "mine", "goal": "去赤枫岭旧矿道看个究竟：护院不让生人进去——硬闯、收着气息摸进去，或拿陆家的名头叫门。", "place": "chifeng", "done": [{"flag": "lu_mine_cleared"}], "after": "石屋里锁着十几个矿工，手臂上全是针眼，有两个已经起不来了。墙上挂着一本册子，记着每人每天服了几钱药胚、气血涨落几分——陆家的延寿药，是拿活人试出来的。", "effects": [{"mind": 2}]}, {"id": "decide", "goal": "陆承舟赶来了。同他商量，这件事怎么了结。", "place": "chifeng", "choice_event": "lu_choice"}]},
  "chixiao_fire": {"title": "地火将熄", "giver": "yan_qianqiu", "steps": [{"id": "eye", "goal": "去赤枫岭地火熔窟最深处的火眼，看看地火为什么弱了（熔岩火灵把守）。", "place": "chifeng", "done": [{"flag": "fire_eye_seen"}], "after": "火眼一侧结着青灰色的冷壳，寒气从地底倒灌上来，来路正对着落霞谷。落霞谷的泉被火烫醒了妖蟒，赤霄的火被泉压弱了炉——原来是一根脉的两头。", "effects": [{"mind": 2}]}, {"id": "decide", "goal": "回赤霄门器坊，把火眼里的事告诉炎千秋，一起拿个主意。", "place": "chixiao_gate", "choice_event": "chixiao_choice"}]},
  "changqing_garden": {"title": "泽心旧园", "giver": "lin_wanzhao", "steps": [{"id": "garden", "goal": "去毒泽泽心，找长青谷两百年前的老药园（瘴蟒盘踞毒潭）。", "place": "duze", "done": [{"flag": "garden_seeds_found"}], "after": "药庐里的药种匣完好无损，匣底压着一页「借命方」，朱批写着：此方以人续人，永不可用。墙根下那丛回天草，也许将来用得着。", "effects": [{"flag": "huitian_known"}]}, {"id": "decide", "goal": "把药种匣带回长青谷，交给林晚照——或者不交。", "place": "changqing_valley", "choice_event": "garden_choice"}]},
  "xuanyue_tomb": {"title": "剑冢", "giver": "shi_zhenyue", "steps": [{"id": "tomb", "goal": "去断剑峡最深处的剑冢（剑冢剑意把守），看清底下镇着什么。", "place": "duanjian", "done": [{"flag": "tomb_reached"}], "after": "剑意退去，石丘底下露出一块残碑：剑下有门，门后有城。碑角刻着一枚城徽——和你铜片上的一模一样。", "effects": [{"mind": 3}], "major": true}, {"id": "decide", "goal": "回玄岳宗，同石镇岳商量剑冢往后归谁。", "place": "xuanyue_gate", "choice_event": "xuanyue_choice"}]},
  "zhaoshui": {"title": "照水分光", "giver": "bai_tinglan", "steps": [{"id": "canpian", "goal": "寻《照水分光诀》的上半部：沧澜城药市寄卖着藏书院的抄本（八百灵石），近海沉船的船长舱里也许还藏着一份。", "place": "canglan", "done": [{"item_at_least": ["zhaoshui_canpian", 1]}], "after": "残篇到手。上半部讲以水映金，下半部被人撕去了——没有下半部，练不成。"}, {"id": "complete", "goal": "补全下半部：带一块潮心石去沧澜阁观潮台请白听澜指点（交情「友好」，或身为沧澜客卿），或到近海沉船的龙骨剑匣里自己找。", "place": "canglan_pavilion", "done": [{"item_at_least": ["zhaoshui_canpian", 1]}, {"any": [{"flag": "zhaoshui_taught"}, {"flag": "zhaoshui_found"}]}], "after": "上下两篇合在一处，水剑一脉在你手里接上了。白听澜听说以后，托人带了句话：沧澜阁欠这一脉一个传人，也欠你一个客卿的位子。", "effects": [{"take_item": "zhaoshui_canpian"}, {"slip": "zhaoshui"}, {"guest_invite": "canglan"}, {"mind": 3}], "major": true}]},
  "tingchao": {"title": "听潮剑", "giver": "bai_tinglan", "steps": [{"id": "lore", "goal": "去沧澜城藏书院，查一查这柄锈剑的来历。", "place": "canglan", "done": [{"at_location": "canglan"}], "after": "藏书院的船簿里记着：一百年前，沧澜阁长老观潮君乘「观潮」号出海测潮，船沉在近海，佩剑听潮随船而没。修复要两步——先到南明万宝楼剔锈补刃（玄铁两份、海灵贝两枚、二百灵石），再到赤霄器坊以潮心石压住剑心（地火精两枚、八百灵石，须筑基后期）。", "effects": [{"flag": "tingchao_known"}]}, {"id": "mend1", "goal": "带玄铁两份、海灵贝两枚与二百灵石去南明万宝楼，请器师给听潮剑剔锈补刃。", "place": "nanming", "choice_event": "tingchao_mend1"}, {"id": "mend2", "goal": "带潮心石一块、地火精两枚与八百灵石去赤霄器坊，复原听潮剑（须筑基后期）。潮心石在近海沉船的货舱里，礁滩上偶尔也能拾到。", "place": "chixiao_gate", "choice_event": "tingchao_mend2"}]},
  "ye_master": {"title": "师父的寿", "giver": "ye_zhiwei", "begin_if": [{"year_at_least": 70}, {"met": "ye_zhiwei"}, {"realm_at_least": 1}], "close_if": [{"year_at_least": 72}], "closed": "葛青囊已经坐化了。", "steps": [{"id": "letter", "letter": true, "say": "“师父的寿元，只剩一年多了。你……能来一趟沧澜城丹会吗？”", "goal": "去沧澜城丹会见叶知微。", "place": "canglan", "done": [{"at_location": "canglan"}], "after": "葛青囊还在前堂坐着看病，咳嗽一声接一声。叶知微把你拉到后院，说她在毒泽打听到两样东西：一张以人续人的借命方，和一种只长在泽心的回天草。", "effects": [{"flag": "ye_crisis"}, {"flag": "huitian_known"}, {"meet": "ge_qingnang"}]}, {"id": "decide", "goal": "历元七十一年底以前，回沧澜城丹会同叶知微定下怎么办。回天草长在毒泽泽心的老药园里，泽畔采药偶尔也能碰上。", "place": "canglan", "choice_event": "ye_choice"}]},
  "wenren_chart": {"title": "古海图", "giver": "wenren_zhao", "begin_if": [{"year_at_least": 110}, {"met": "wenren_zhao"}, {"realm_at_least": 1}], "steps": [{"id": "letter", "letter": true, "say": "“这回是真的！来望海船坞，给你看样东西。”", "goal": "去望海城船坞找闻人照。", "place": "wanghai", "done": [{"at_location": "wanghai"}], "after": "闻人照摊开一张羊皮海图，墨色旧得发褐。近海群岛的沉船湾底下画着一道门，门楣上的纹样，正是镜中那座城的城徽。“图上说，门后还有路。”", "effects": [{"flag": "wenren_chart"}, {"relation": ["wenren_zhao", 5]}]}, {"id": "verify", "goal": "同闻人照去近海群岛，到沉船湾深处的礁下石门验图（海船两日；货舱里有水鬼）。", "place": "jinhai", "done": [{"flag": "chart_verified"}], "after": "石门就在那里，城徽一笔不差。闻人照摸着门楣，半天才说出话来：“十回寻宝九回扑空……这回，是那一成。”", "effects": [{"mind": 3}, {"relation": ["wenren_zhao", 10]}], "major": true}, {"id": "ship", "goal": "回望海船坞，跟闻人照商量出海的事。", "place": "wanghai", "choice_event": "wenren_ship"}, {"id": "sail", "letter": true, "requires": [{"year_at_least": 130}], "say": "“船明早开。来不来？”", "goal": "历元一百三十年开春，去望海港口：依约登船，或给闻人照送行。", "place": "wanghai", "choice_event": "wenren_sail"}], "close_if": [{"flag": "wenren_lost"}], "closed": "闻人照的船已经开走了。"},
  "jindan_plan": {"title": "结丹之备", "giver": "shen_mo", "begin_if": [{"affiliation": ""}, {"stage_at_least": [1, 2]}, {"flag": "tiannan_known"}], "close_if": [{"any": [{"realm_at_least": 2}, {"not": {"affiliation": ""}}]}], "closed": "结丹之备不必再提。", "steps": [{"id": "ask", "letter": true, "say": "“筑基后期了？结丹的事，云溪帮不上你。去沧澜城藏书院坐坐，那里的老先生懂。”", "goal": "去沧澜城藏书院打听结丹的门道。", "place": "canglan", "done": [{"at_location": "canglan"}], "after": "藏书院的老先生说：结丹不用丹药，靠自己。值得争取的有四样——凝丹之法（药市寄卖的《凝丹要略》，或请一位交情深的首徒相赠）、金丹用的天材地宝（霞光灵髓、地心火莲）、一处好地方（灵眼，或城东的水榭小筑）、一个靠得住的护法。四样都不是非有不可。"}, {"id": "prep", "goal": "结丹的准备，能备几样备几样：读《凝丹要略》、寻一样金丹天材地宝、找一处好地方、请人护法。都不是非有不可。", "place": "canglan", "done": [{"any": [{"flag": "ningdan_known"}, {"item_at_least": ["xiaguang_lingsui", 1]}, {"item_at_least": ["dixin_huolian", 1]}, {"flag": "canglan_abode"}, {"stage_at_least": [1, 3]}]}], "after": "该备的备了一些。剩下的，只看你自己。"}]},
  "jindan_sect": {"title": "结丹之备", "giver": "gu_changgeng", "begin_if": [{"affiliation": "qingyun"}, {"stage_at_least": [1, 2]}], "close_if": [{"any": [{"realm_at_least": 2}, {"not": {"affiliation": "qingyun"}}]}], "closed": "结丹之备不必再提。", "steps": [{"id": "ask", "letter": true, "speaker": "gu_changgeng", "say": "“筑基后期了。回传功堂一趟，说说结丹。”", "goal": "回青云山传功堂，听顾长庚说结丹。", "place": "sect", "done": [{"at_location": "sect"}], "after": "顾长庚说：结丹不用丹药，靠自己。本门执事堂有一部《凝丹要略》，内门弟子四百贡献可换；金丹用的天材地宝要自己去寻；静室就在山上，护法仍请他。“不必样样齐全。准备得越久，寿元也走得越远。”"}, {"id": "prep", "goal": "结丹的准备，能备几样备几样：换一部《凝丹要略》、寻一样金丹天材地宝、修到筑基圆满再请顾长老护法。", "place": "sect", "done": [{"any": [{"flag": "ningdan_known"}, {"item_at_least": ["xiaguang_lingsui", 1]}, {"item_at_least": ["dixin_huolian", 1]}, {"stage_at_least": [1, 3]}]}], "after": "该备的备了一些。剩下的，只看你自己。"}]},
  "wuzong_prep": {"title": "论道之备", "giver": "storyteller", "begin_if": [{"realm_at_least": 2}, {"flag": "wuzong_notice"}], "steps": [{"id": "aim", "goal": "五宗论道十月开坛（会址看日程）。想好去做什么：登台斗法要有资格（青云弟子、某宗客卿、天南大比魁首，或一位首徒交情「信赖」）；展示要一件法宝以上的宝物或一部地阶功法；观战论道、指点后辈，谁都可以。", "done": [{"flag": "wuzong_seen"}], "after": "论道散了。台上的胜负、台下的交谈、展台前的人，各自记在心里。下一回，又是一甲子以后。"}]},
  "wenren_search": {"title": "寻人", "giver": "wei_sanniang", "begin_if": [{"flag": "wenren_lost"}, {"met": "wenren_zhao"}], "steps": [{"id": "ask", "goal": "闻人照的船没回来：去望海港口问问卫三娘，船往哪边去了。", "place": "wanghai", "done": [{"at_location": "wanghai"}], "after": "卫三娘抽着烟：“东南，雾岛那边。那片海，船进去多半出不来——要去，得会御剑渡海，金丹才行。”她把一张画着雾岛的草图推过来，“找到了，替我骂他一句。”", "effects": [{"meet": "wei_sanniang"}, {"flag": "wenren_heard"}]}, {"id": "island", "goal": "去外海雾岛找闻人照（近海群岛东南，金丹御剑渡海 4 日）。", "place": "waihai", "done": [{"any": [{"flag": "wenren_found_alive"}, {"flag": "wenren_found_dead"}]}], "major": true}]},
